# Variables de l'environnement de production. Copier en .env.prod (ignoré par Git)
# ou, mieux, les injecter depuis un gestionnaire de secrets (ADR-0004).
# Rotation des mots de passe : tous les 90 jours au maximum.
GITHUB_OWNER=votre-compte-github
APP_VERSION=1.0.0

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=livraison_app
MONGO_APP_PASSWORD=
MONGO_ETL_USERNAME=livraison_etl
MONGO_ETL_PASSWORD=

MODEL_THRESHOLD=0.5
RETRAIN_MIN_NEW_ORDERS=500
RETRAIN_CHECK_INTERVAL_SECONDS=3600
