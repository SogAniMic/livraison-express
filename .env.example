# Copier en .env pour le développement local. Ne jamais versionner le .env.
# En test/prod, ces valeurs sont injectées par docker compose (variables d'environnement).

# --- Général ---
ENVIRONMENT=local            # local | test | prod
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
RANDOM_SEED=42

# --- Modèle (ADR-0000) ---
MODEL_PATH=artifacts/express_delivery_model.joblib
MODEL_THRESHOLD=0.5
MODEL_VERSION=1.0.0

# --- Stockage des commandes (ADR-0005) ---
# memory:// -> données synthétiques du notebook (aucune base requise)
# mongodb://hote:27017 -> base analytique alimentée par l'ETL
ORDER_REPOSITORY_URL=memory://
MONGO_DATABASE=livraison_express
MONGO_ERP_COLLECTION=orders
MONGO_COLLECTED_COLLECTION=api_orders

# --- Réentraînement (ADR-0007) ---
RETRAIN_MIN_NEW_ORDERS=500
RETRAIN_CHECK_INTERVAL_SECONDS=300
MIN_TRAINING_ROWS=200
